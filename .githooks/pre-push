#!/bin/sh
set -e

# pre-push hook: ensures no non-compliant tags are pushed to remote
TAG_REGEX='^refs/tags/v[0-9]+\.[0-9]+\.[0-9]+\+[0-9]+(\.[0-9]+)*$'

while read -r local_ref local_oid remote_ref remote_oid; do
    if echo "$local_ref" | grep -q '^refs/tags/' && [ "$local_oid" != "0000000000000000000000000000000000000000" ]; then
        if ! echo "$local_ref" | grep -E -q "$TAG_REGEX"; then
            TAG_NAME=$(echo "$local_ref" | sed 's#^refs/tags/##')
            echo "" >&2
            echo "❌ [Git Push 拦截]: 待推送的标签 '$TAG_NAME' 不符合 SemVer 2.0 构建元数据规范！" >&2
            echo "----------------------------------------------------------------------" >&2
            echo "📌 必须遵循格式: v<主版本>.<次版本>.<修订号>+<禅道版本>" >&2
            echo "💡 合法示例:     v1.0.9+21.7" >&2
            echo "----------------------------------------------------------------------" >&2
            echo "" >&2
            exit 1
        fi
    fi
done
